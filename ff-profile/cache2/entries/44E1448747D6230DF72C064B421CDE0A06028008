<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FWS Console</title>
<link rel="stylesheet" href="css/app.css">
<script>
  // Resolve the stored theme before first paint so there is no flash.
  (function () {
    var t = null;
    try { t = localStorage.getItem('fws-theme'); } catch (e) {}
    if (t === 'system' || !t) {
      t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      // dark-first: with no stored choice we stay dark unless the OS says light
    }
    if (t === 'light') document.documentElement.dataset.theme = 'light';
  })();
</script>
</head>
<body>

